# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=storerating_db
# Optional full connection URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storerating_db

# JWT Authentication Secret (Required - Never use default/fallback)
JWT_SECRET=

# Seed Passwords (Optional custom seed credentials - placeholders only)
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_USER_PASSWORD=
