# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=storerating_db

# Optional full connection URL
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/storerating_db

# JWT Authentication Secret
JWT_SECRET=your_secure_jwt_secret

# Optional seed passwords
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_USER_PASSWORD=